HTTP_PORT=80

POSTGRES_DB=crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://crm_user:change-me@localhost:5432/crm

REDIS_URL=redis://localhost:6379
REDIS_SESSION_PREFIX=ccrms:sess:
REDIS_RATE_LIMIT_PREFIX=ccrms:rate:
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=20
SESSION_TTL_SECONDS=28800
# Set true whenever the app is served over HTTPS (required for production).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# MinIO object/document storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=cdex-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=crm-files

JWT_SECRET=change-me-use-a-random-secret-at-least-32-chars
FRONTEND_ORIGIN=http://localhost
FRONTEND_URL=http://localhost

VITE_API_URL=/api

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me
AZURE_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
AZURE_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
AZURE_JWKS_URI=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
AZURE_AUDIENCE=00000000-0000-0000-0000-000000000000
AZURE_REDIRECT_URI=http://localhost:5000
